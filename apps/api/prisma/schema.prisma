generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==================== ENUM ====================

enum Role {
  ADMIN
  STAFF
  CUSTOMER
}

enum OAuthProvider {
  GOOGLE
  FACEBOOK
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum InventoryType {
  EXPORT
  ADJUSTMENT
  RETURN
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPING
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  CANCELLED
  EXPIRED
  REFUNDED
}

enum NotificationType {
  ORDER_CREATED
  ORDER_SHIPPING
}

// ==================== AUTH ====================

model User {
  id            Int            @id @default(autoincrement())
  email         String         @unique
  password      String?
  name          String?
  phone         String?
  avatar        String?
  role          Role           @default(CUSTOMER)
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  oauthAccounts OAuthAccount[]
  addresses     Address[]
  orders        Order[]
  payments      Payment[]
  wishlist      Wishlist[]
  cart          Cart?
  notifications Notification[]

  @@map("users")
}

model OAuthAccount {
  id         Int           @id @default(autoincrement())
  provider   OAuthProvider
  providerId String        @map("provider_id")
  userId     Int           @map("user_id")
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime      @default(now()) @map("created_at")

  @@unique([provider, providerId])
  @@map("oauth_accounts")
}

// ==================== ADDRESS ====================

model Address {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName  String   @map("full_name")
  phone     String
  province  String
  district  String
  ward      String
  street    String
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  orders    Order[]

  @@map("addresses")
}

// ==================== PRODUCT ====================

model Category {
  id        Int        @id @default(autoincrement())
  name      String
  slug      String     @unique
  parentId  Int?       @map("parent_id")
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  products  Product[]
  createdAt DateTime   @default(now()) @map("created_at")

  @@map("categories")
}

model Product {
  id          Int              @id @default(autoincrement())
  name        String
  slug        String           @unique
  description String?
  images      String[]
  categoryId  Int?             @map("category_id")
  category    Category?        @relation(fields: [categoryId], references: [id])
  status      ProductStatus    @default(DRAFT)
  variants    ProductVariant[]
  wishlist    Wishlist[]
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@map("products")
}

model ProductVariant {
  id           Int                    @id @default(autoincrement())
  productId    Int                    @map("product_id")
  product      Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku          String                 @unique
  name         String
  attributes   Json
  price        Decimal                @db.Decimal(12, 2)
  comparePrice Decimal?               @map("compare_price") @db.Decimal(12, 2)
  weight       Float?
  length       Float?
  width        Float?
  height       Float?
  inventory    Inventory?
  transactions InventoryTransaction[]
  orderItems   OrderItem[]
  cartItems    CartItem[]
  createdAt    DateTime               @default(now()) @map("created_at")
  updatedAt    DateTime               @updatedAt @map("updated_at")

  @@map("product_variants")
}

// ==================== INVENTORY ====================

model Inventory {
  id        Int            @id @default(autoincrement())
  variantId Int            @unique @map("variant_id")
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int            @default(0)
  lowStock  Int            @default(5) @map("low_stock")
  updatedAt DateTime       @updatedAt @map("updated_at")

  @@map("inventories")
}

model InventoryTransaction {
  id          Int            @id @default(autoincrement())
  variantId   Int            @map("variant_id")
  variant     ProductVariant @relation(fields: [variantId], references: [id])
  type        InventoryType
  quantity    Int
  note        String?
  referenceId Int?           @map("reference_id")
  createdById Int            @map("created_by_id")
  createdAt   DateTime       @default(now()) @map("created_at")

  @@map("inventory_transactions")
}

// ==================== SHIPPING ====================

model ShippingRate {
  id          Int      @id @default(autoincrement())
  name        String
  provinces   String[]
  baseWeight  Float    @map("base_weight")
  basePrice   Decimal  @map("base_price") @db.Decimal(12, 2)
  extraWeight Float    @map("extra_weight")
  extraPrice  Decimal  @map("extra_price") @db.Decimal(12, 2)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("shipping_rates")
}

// ==================== ORDER ====================

model Order {
  id              Int                  @id @default(autoincrement())
  userId          Int                  @map("user_id")
  user            User                 @relation(fields: [userId], references: [id])
  addressId       Int                  @map("address_id")
  address         Address              @relation(fields: [addressId], references: [id])
  paymentId       Int?                 @unique @map("payment_id")
  payment         Payment?             @relation(fields: [paymentId], references: [id])
  status          OrderStatus          @default(PENDING_PAYMENT)
  note            String?
  trackingCode    String?              @unique @map("tracking_code")
  subtotal        Decimal              @db.Decimal(12, 2)
  shippingFee     Decimal              @map("shipping_fee") @db.Decimal(12, 2)
  discount        Decimal              @default(0) @db.Decimal(12, 2)
  total           Decimal              @db.Decimal(12, 2)
  items           OrderItem[]
  statusHistories OrderStatusHistory[]
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  @@map("orders")
}

model OrderItem {
  id        Int            @id @default(autoincrement())
  orderId   Int            @map("order_id")
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId Int            @map("variant_id")
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  name      String
  sku       String
  price     Decimal        @db.Decimal(12, 2)
  quantity  Int
  total     Decimal        @db.Decimal(12, 2)

  @@map("order_items")
}

model OrderStatusHistory {
  id        Int         @id @default(autoincrement())
  orderId   Int         @map("order_id")
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  createdBy Int         @map("created_by")
  createdAt DateTime    @default(now()) @map("created_at")

  @@map("order_status_histories")
}

// ==================== PAYMENT ====================

model Payment {
  id          Int           @id @default(autoincrement())
  userId      Int           @map("user_id")
  user        User          @relation(fields: [userId], references: [id])
  amount      Decimal       @db.Decimal(12, 2)
  orderCode   BigInt        @unique @map("order_code")
  description String
  checkoutUrl String?       @map("checkout_url")
  qrCode      String?       @map("qr_code")
  status      PaymentStatus @default(PENDING)
  expiredAt   DateTime      @map("expired_at")
  paidAt      DateTime?     @map("paid_at")
  gatewayData Json?         @map("gateway_data")
  createdAt   DateTime      @default(now()) @map("created_at")
  order       Order?

  @@map("payments")
}

// ==================== NOTIFICATION ====================

model Notification {
  id          Int              @id @default(autoincrement())
  userId      Int              @map("user_id")
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        NotificationType
  title       String
  body        String
  referenceId Int?             @map("reference_id")
  isRead      Boolean          @default(false) @map("is_read")
  emailSentAt DateTime?        @map("email_sent_at")
  createdAt   DateTime         @default(now()) @map("created_at")

  @@map("notifications")
}

// ==================== WISHLIST & CART ====================

model Wishlist {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int      @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, productId])
  @@map("wishlists")
}

model Cart {
  id        Int        @id @default(autoincrement())
  userId    Int        @unique @map("user_id")
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@map("carts")
}

model CartItem {
  id        Int            @id @default(autoincrement())
  cartId    Int            @map("cart_id")
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId Int            @map("variant_id")
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  quantity  Int            @default(1)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  @@unique([cartId, variantId])
  @@map("cart_items")
}
